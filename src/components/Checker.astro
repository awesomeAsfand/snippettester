---
export interface Props { compact?: boolean }
const { compact = false } = Astro.props;
---
<div class="checker" id="checker">
  {!compact && (
    <>
      <p class="eyebrow">Free · no signup · no email required</p>
      <h2 style="font-size: clamp(1.4rem, 3vw, 1.85rem);">Is your page shaped so an answer engine can quote it?</h2>
      <p style="color: var(--ink-2); margin-bottom: 1.25rem;">
        Eight measurable signals, scored out of 100. Every point traces to something in your HTML or
        robots.txt, so it cannot invent a finding.
      </p>
    </>
  )}

  <form class="checker__form" id="checker-form" novalidate>
    <label class="skip" for="checker-url">Page URL to check</label>
    <input
      class="checker__input"
      id="checker-url"
      name="url"
      type="url"
      inputmode="url"
      autocomplete="url"
      placeholder="yourdomain.com/the-page-you-care-about"
      required
    />
    <button class="btn btn--accent" type="submit" id="checker-btn">Run the check</button>
  </form>

  <p class="checker__note" id="checker-note">
    Checks structured data, answer-first structure, heading order, extractable formats, evidence
    density, content placement, AI crawler access and metadata.
  </p>

  <div class="checker__out" id="checker-out" hidden aria-live="polite"></div>
</div>

<script is:inline>
  (() => {
    const form = document.getElementById('checker-form');
    if (!form) return;
    const input = document.getElementById('checker-url');
    const btn = document.getElementById('checker-btn');
    const out = document.getElementById('checker-out');
    const note = document.getElementById('checker-note');
    const idleNote = note.textContent;

    const esc = (s) =>
      String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

    const ringColour = (pct) =>
      pct >= 80 ? 'var(--ok)' : pct >= 60 ? 'var(--mid)' : pct >= 40 ? 'var(--accent)' : 'var(--bad)';

    function renderError(msg) {
      out.hidden = false;
      out.innerHTML =
        '<div class="callout" style="border-color: var(--bad); background: var(--bad-soft);"><p><strong>Could not check that page.</strong></p><p style="margin:0;">' +
        esc(msg) +
        '</p></div>';
    }

    function render(d) {
      const C = 2 * Math.PI * 36;
      const dash = (d.score / 100) * C;
      const rows = d.signals
        .map((s) => {
          const pct = Math.round((s.points / s.max) * 100);
          const label = s.verdict === 'ok' ? 'Pass' : s.verdict === 'mid' ? 'Partial' : 'Gap';
          return `
          <div class="signal">
            <div class="signal__head">
              <span class="badge badge--${esc(s.verdict)}">${label}</span>
              <span class="signal__name">${esc(s.name)}</span>
              <span class="signal__pts">${s.points}/${s.max}</span>
            </div>
            <div class="signal__bar"><i style="width:${pct}%;background:${ringColour(pct)}"></i></div>
            <p class="signal__fix"><span class="mono" style="color:var(--muted)">${esc(s.detail)}</span><br />${esc(s.fix)}</p>
          </div>`;
        })
        .join('');

      out.hidden = false;
      out.innerHTML = `
        <div class="score">
          <div class="score__ring">
            <svg width="84" height="84" viewBox="0 0 84 84" aria-hidden="true">
              <circle cx="42" cy="42" r="36" fill="none" stroke="var(--rule)" stroke-width="7" />
              <circle cx="42" cy="42" r="36" fill="none" stroke="${ringColour(d.score)}" stroke-width="7"
                stroke-linecap="round" stroke-dasharray="${dash.toFixed(1)} ${C.toFixed(1)}" />
            </svg>
            <span>${d.score}</span>
          </div>
          <div class="score__txt">
            <h3>${esc(d.band)} — ${d.score}/100</h3>
            <p>${esc(d.summary)}</p>
          </div>
        </div>
        ${rows}
        <div class="callout" style="margin-bottom:0;">
          <p><strong>Want the fixes done rather than listed?</strong> Send me this URL and I will
          reply with what I would change first and what it would cost — no call needed to find out.</p>
          <p style="margin:0;"><a class="btn btn--ghost" href="/contact?url=${encodeURIComponent(d.url)}">Get the fix list</a></p>
        </div>
        <p class="source-note" style="margin-top:1rem;">Checked ${esc(d.url)} · ${new Date(d.checkedAt).toLocaleString()}</p>
      `;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const url = input.value.trim();
      if (!url) return;
      btn.disabled = true;
      const original = btn.textContent;
      btn.innerHTML = '<span class="spinner"></span> Checking';
      note.textContent = 'Fetching the page and its robots.txt…';
      out.hidden = true;

      try {
        const res = await fetch('/api/audit', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ url }),
        });
        const ct = res.headers.get('content-type') || '';
        if (!ct.includes('application/json')) {
          throw new Error(
            'The checker endpoint is not responding. If you are running this locally, use "npx wrangler pages dev dist" so the /functions directory is served.',
          );
        }
        const data = await res.json();
        if (data.error) throw new Error(data.error);
        render(data);
      } catch (err) {
        renderError(err.message || 'Something went wrong.');
      } finally {
        btn.disabled = false;
        btn.textContent = original;
        note.textContent = idleNote;
      }
    });
  })();
</script>
