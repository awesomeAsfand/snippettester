---
import '../styles/global.css';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  schema?: unknown[];
  noindex?: boolean;
}
const { title, description, schema = [], noindex = false } = Astro.props;
const path = Astro.url.pathname;

const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://snippettester.com/#org',
  name: 'Snippet Tester',
  url: 'https://snippettester.com',
  email: 'hello@snippettester.com',
  description:
    'Evidence-led SEO and answer-engine optimisation. Free AEO readiness checker, published site teardowns, transparent pricing.',
  slogan: 'The evidence first — including the parts that say you do not need us.',
  knowsAbout: [
    'Search engine optimisation',
    'Answer engine optimisation',
    'Generative engine optimisation',
    'Google AI Overviews',
    'Schema.org structured data',
    'Technical SEO',
  ],
  areaServed: { '@type': 'Place', name: 'Worldwide' },
  serviceType: ['SEO', 'Answer Engine Optimisation', 'Technical site audit'],
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://snippettester.com/#website',
  url: 'https://snippettester.com',
  name: 'Snippet Tester',
  publisher: { '@id': 'https://snippettester.com/#org' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} path={path} schema={[org, website, ...schema]} noindex={noindex} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
