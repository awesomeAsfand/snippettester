---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page does not exist on snippettester.com. Try the free AEO checker, the evidence base, or the published teardowns instead." noindex={true}>
  <section class="section">
    <div class="wrap prose">
      <p class="eyebrow">404</p>
      <h1>That page is not here.</h1>
      <p class="lede">
        Which is itself a small SEO problem, so thank you for finding it. Try one of these instead.
      </p>
      <ul class="quiet-list">
        <li><a href="/#checker">Run the free AEO check</a></li>
        <li><a href="/evidence">The evidence base</a></li>
        <li><a href="/teardowns">Published teardowns</a></li>
        <li><a href="/pricing">Pricing</a></li>
      </ul>
    </div>
  </section>
</Base>
